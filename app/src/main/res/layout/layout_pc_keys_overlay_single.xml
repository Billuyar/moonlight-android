<?xml version="1.0" encoding="utf-8"?>
<!--
PC-keys overlay, single-row variant for phones / smaller screens (<900dp).
Compact 7-key set: Tab, ESC, the arrow cluster, and Enter. Modifiers and
Backspace are omitted because there isn't enough horizontal room on a 5.8"
device (Galaxy S10e ≈ 760dp landscape) for 12 keys to be reliably tappable.
The full 12-key set lives in res/layout-w900dp/ for tablets.

Each key uses android:tag = Android KeyEvent.KEYCODE_*. Layout weights mean
the row shrinks proportionally in portrait orientation rather than overflowing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:padding="3dp"
    android:background="#212121"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="110" android:layout_margin="2dp" android:background="@drawable/bg_ax_keyboard_button" android:gravity="center" android:textColor="#FFFFFF" android:tag="61"  android:text="Tab" android:textSize="14sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="110" android:layout_margin="2dp" android:background="@drawable/bg_ax_keyboard_button" android:gravity="center" android:textColor="#FFFFFF" android:tag="111" android:text="ESC" android:textSize="14sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="110" android:layout_margin="2dp" android:background="@drawable/bg_ax_keyboard_button" android:gravity="center" android:textColor="#FFFFFF" android:tag="ime" android:text="⌨" android:textSize="22sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:layout_margin="2dp" android:background="@drawable/bg_ax_keyboard_button" android:gravity="center" android:textColor="#FFFFFF" android:tag="21"  android:text="←"   android:textSize="18sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:layout_margin="2dp" android:background="@drawable/bg_ax_keyboard_button" android:gravity="center" android:textColor="#FFFFFF" android:tag="19"  android:text="↑"   android:textSize="18sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:layout_margin="2dp" android:background="@drawable/bg_ax_keyboard_button" android:gravity="center" android:textColor="#FFFFFF" android:tag="20"  android:text="↓"   android:textSize="18sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="100" android:layout_margin="2dp" android:background="@drawable/bg_ax_keyboard_button" android:gravity="center" android:textColor="#FFFFFF" android:tag="22"  android:text="→"   android:textSize="18sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="130" android:layout_margin="2dp" android:background="@drawable/bg_ax_keyboard_button" android:gravity="center" android:textColor="#FFFFFF" android:tag="66"  android:text="⏎"   android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
